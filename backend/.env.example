PORT=3000
GEMINI_API_KEY=your_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGIN=http://localhost:1425

# Optional: comma-separated keys used for round-robin rotation and failover.
# When GEMINI_API_KEYS is set, it takes precedence over GEMINI_API_KEY.
# GEMINI_API_KEYS=key1,key2,key3

# Optional tuning
# REQUEST_BODY_LIMIT=16kb
# MAX_MESSAGE_LENGTH=4000
# MAX_HISTORY_MESSAGES=40
# MAX_CONTEXT_MESSAGES=20
# MAX_CONTEXT_CHARS=12000
# SESSION_TTL_MS=7200000
# AI_TIMEOUT_MS=30000
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_MAX=60
# LOG_LEVEL=info

# Optional cloud speech adapter (browser Web Speech API is used by default)
# SPEECH_PROVIDER=
# SPEECH_API_KEY=
